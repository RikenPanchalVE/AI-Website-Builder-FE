# Vite automatically uses THIS file (not .env) whenever you run
# `npm run build` - so a plain `npm run build` bakes in the right
# production API URL by itself, no need to type
# `VITE_API_URL=... npm run build` every time.
#
# `.env` (blank VITE_API_URL) still applies to `npm run dev`, so local
# dev is unaffected.
VITE_API_URL=https://aiwebsitebuilderserver.vestaging.in
